<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's hooks before WPF starts, so App.xaml is a plain Page. -->
    <StartupObject>AutoClick.UI.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- The exe name is part of the Velopack install layout: never rename it. -->
    <AssemblyName>AutoClick.UI</AssemblyName>
    <RootNamespace>AutoClick.UI</RootNamespace>
    <AssemblyTitle>AutoClick</AssemblyTitle>
    <Description>Auto-click utility for games. Background clicking via the Win32 PostMessage API.</Description>
    <Win32Resource />
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoClick.Core\AutoClick.Core.csproj" />
    <ProjectReference Include="..\AutoClick.Services\AutoClick.Services.csproj" />
    <ProjectReference Include="..\AutoClick.Win32\AutoClick.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoClick.Architecture.Tests" />
    <!-- WPF leaves System.IO out of the implicit usings (Path clashes with Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window, tray and About page icon (pack://application:,,,/Assets/app.ico). -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opened from the About page. THIRD-PARTY-NOTICES.txt is generated into the publish
         folder by eng/New-ThirdPartyNotices.ps1 during CI and release builds. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
