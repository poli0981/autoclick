<Page
    x:Class="AutoClick.UI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:AutoClick.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:AutoClick.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutoClick.UI.ViewModels"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=False}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="0,8,0,24">
        <ui:TextBlock FontTypography="Title" Text="{l:Loc Nav_Settings}" />

        <!--  Appearance  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{l:Loc Settings_Appearance}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_Language}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_LanguageHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                DisplayMemberPath="NativeName"
                AutomationProperties.Name="{l:Loc Settings_Language}"
                ItemsSource="{x:Static vm:SettingsViewModel.Languages}"
                SelectedValue="{Binding Language}"
                SelectedValuePath="Code" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_Theme}" />
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemTemplate="{StaticResource OptionTemplate}"
                AutomationProperties.Name="{l:Loc Settings_Theme}"
                ItemsSource="{x:Static vm:SettingsViewModel.Themes}"
                SelectedValue="{Binding Theme}"
                SelectedValuePath="Value" />
        </ui:CardControl>

        <!--  Clicking  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{l:Loc Settings_Clicking}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Games24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_Mode}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_ModeHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemTemplate="{StaticResource OptionTemplate}"
                AutomationProperties.Name="{l:Loc Settings_Mode}"
                ItemsSource="{x:Static vm:SettingsViewModel.SettingsModes}"
                SelectedValue="{Binding SettingsMode}"
                SelectedValuePath="Value" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_DefaultTiming}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_DefaultTimingHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="140"
                    Margin="0,0,8,0"
                    ItemTemplate="{StaticResource OptionTemplate}"
                    AutomationProperties.Name="{l:Loc Settings_DefaultTiming}"
                    ItemsSource="{x:Static vm:SettingsViewModel.TimingModes}"
                    SelectedValue="{Binding TimingMode}"
                    SelectedValuePath="Value" />
                <ui:NumberBox
                    Width="130"
                    Maximum="{x:Static vm:SettingsViewModel.MaxInterval}"
                    Minimum="{x:Static vm:SettingsViewModel.MinInterval}"
                    PlaceholderText="{l:Loc Timing_Interval}"
                    ToolTip="{l:Loc Timing_Interval}"
                    AutomationProperties.Name="{l:Loc Timing_Interval}"
                    Value="{Binding FixedInterval, Mode=TwoWay}"
                    Visibility="{Binding IsFixedTiming, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFixedTiming, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:NumberBox
                        Width="130"
                        Margin="0,0,8,0"
                        Maximum="{x:Static vm:SettingsViewModel.MaxInterval}"
                        Minimum="{x:Static vm:SettingsViewModel.MinInterval}"
                        PlaceholderText="{l:Loc Timing_Min}"
                        ToolTip="{l:Loc Timing_Min}"
                        AutomationProperties.Name="{l:Loc Timing_Min}"
                        Value="{Binding RandomMin, Mode=TwoWay}" />
                    <ui:NumberBox
                        Width="130"
                        Maximum="{x:Static vm:SettingsViewModel.MaxInterval}"
                        Minimum="{x:Static vm:SettingsViewModel.MinInterval}"
                        PlaceholderText="{l:Loc Timing_Max}"
                        ToolTip="{l:Loc Timing_Max}"
                        AutomationProperties.Name="{l:Loc Timing_Max}"
                        Value="{Binding RandomMax, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowRepeatAll24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Timing_SequenceDelay}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_SequenceDelayHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox
                Width="160"
                MaxDecimalPlaces="0"
                Maximum="{x:Static vm:SettingsViewModel.MaxSequenceDelay}"
                Minimum="0"
                SmallChange="50"
                AutomationProperties.Name="{l:Loc Timing_SequenceDelay}"
                Value="{Binding SequenceDelayMs, Mode=TwoWay}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon AppsList24}">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_MaxGames}" />
            </ui:CardControl.Header>
            <ui:NumberBox
                Width="160"
                MaxDecimalPlaces="0"
                Maximum="{x:Static vm:SettingsViewModel.MaxGames}"
                Minimum="{x:Static vm:SettingsViewModel.MinGames}"
                AutomationProperties.Name="{l:Loc Settings_MaxGames}"
                Value="{Binding MaxGamesInQueue, Mode=TwoWay}" />
        </ui:CardControl>

        <!--  Pixel color guard  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{l:Loc Guard_Title}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Eye24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Guard_Enable}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Guard_Hint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Guard_Enable}" IsChecked="{Binding PixelGuardEnabled}" />
        </ui:CardControl>
        <StackPanel IsEnabled="{Binding PixelGuardEnabled}">
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <TextBlock Text="{l:Loc Guard_Tolerance}" />
                </ui:CardControl.Header>
                <ui:NumberBox
                    Width="160"
                    MaxDecimalPlaces="0"
                    Maximum="{x:Static vm:SettingsViewModel.MaxTolerance}"
                    Minimum="0"
                    AutomationProperties.Name="{l:Loc Guard_Tolerance}"
                    Value="{Binding ColorTolerance, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <TextBlock Text="{l:Loc Guard_OnMismatch}" />
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    ItemTemplate="{StaticResource OptionTemplate}"
                    AutomationProperties.Name="{l:Loc Guard_OnMismatch}"
                    ItemsSource="{x:Static vm:SettingsViewModel.MismatchBehaviors}"
                    SelectedValue="{Binding MismatchBehavior}"
                    SelectedValuePath="Value" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Visibility="{Binding IsWaitBehavior, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <TextBlock Text="{l:Loc Guard_WaitTimeout}" />
                </ui:CardControl.Header>
                <ui:NumberBox
                    Width="160"
                    MaxDecimalPlaces="0"
                    Maximum="{x:Static vm:SettingsViewModel.MaxWaitTimeout}"
                    Minimum="{x:Static vm:SettingsViewModel.MinWaitTimeout}"
                    SmallChange="500"
                    AutomationProperties.Name="{l:Loc Guard_WaitTimeout}"
                    Value="{Binding ColorWaitTimeoutMs, Mode=TwoWay}" />
            </ui:CardControl>
        </StackPanel>

        <!--  Hotkeys  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{l:Loc Hotkey_Title}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Hotkey_PauseResume}" />
                    <TextBlock
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Style="{StaticResource Caption}"
                        Text="{Binding PauseResumeStatus}"
                        Visibility="{Binding PauseResumeStatus, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Text="{Binding PauseResumeHotkey}" />
                <ui:Button
                    Command="{Binding RecordHotkeyCommand}"
                    CommandParameter="{x:Static services:HotkeyAction.PauseResume}"
                    Content="{l:Loc Hotkey_Change}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Hotkey_StopAll}" />
                    <TextBlock
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Style="{StaticResource Caption}"
                        Text="{Binding StopAllStatus}"
                        Visibility="{Binding StopAllStatus, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Text="{Binding StopAllHotkey}" />
                <ui:Button
                    Command="{Binding RecordHotkeyCommand}"
                    CommandParameter="{x:Static services:HotkeyAction.StopAll}"
                    Content="{l:Loc Hotkey_Change}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Hotkey_StartAll}" />
                    <TextBlock
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Style="{StaticResource Caption}"
                        Text="{Binding StartAllStatus}"
                        Visibility="{Binding StartAllStatus, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Text="{Binding StartAllHotkey}" />
                <ui:Button
                    Command="{Binding RecordHotkeyCommand}"
                    CommandParameter="{x:Static services:HotkeyAction.StartAll}"
                    Content="{l:Loc Hotkey_Change}" />
            </StackPanel>
        </ui:CardControl>
        <ui:Button
            Margin="0,4,0,0"
            Appearance="Transparent"
            Command="{Binding ResetHotkeysCommand}"
            Content="{l:Loc Hotkey_Reset}"
            Icon="{ui:SymbolIcon ArrowReset24}" />

        <!--  Behavior  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{l:Loc Settings_Behavior}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon SignOut24}">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_ExitBehavior}" />
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemTemplate="{StaticResource OptionTemplate}"
                AutomationProperties.Name="{l:Loc Settings_ExitBehavior}"
                ItemsSource="{x:Static vm:SettingsViewModel.ExitBehaviors}"
                SelectedValue="{Binding ExitBehavior}"
                SelectedValuePath="Value" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_MinimizeOnStartAll}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Settings_MinimizeOnStartAll}" IsChecked="{Binding MinimizeOnStartAll}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_Sounds}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Settings_Sounds}" IsChecked="{Binding SoundNotifications}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_GameExitNotification}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Settings_GameExitNotification}" IsChecked="{Binding ShowGameExitNotification}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_ShowLogs}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Settings_ShowLogs}" IsChecked="{Binding ShowRealTimeLogs}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_AutoUpdate}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_AutoUpdateHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Settings_AutoUpdate}" IsChecked="{Binding AutoUpdate}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_VerboseLogging}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_VerboseLoggingHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Settings_VerboseLogging}" IsChecked="{Binding VerboseLogging}" />
        </ui:CardControl>

        <!--  Administrator  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{l:Loc Admin_Title}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldKeyhole24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Admin_Always}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Admin_AlwaysHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="{l:Loc Admin_Always}" IsChecked="{Binding AlwaysRunAsAdmin}" />
        </ui:CardControl>
        <ui:Button
            Margin="0,4,0,0"
            Command="{Binding RestartAsAdministratorCommand}"
            Content="{l:Loc Admin_Restart}"
            Icon="{ui:SymbolIcon ShieldKeyhole24}"
            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />

        <!--  Data  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{l:Loc Settings_Data}" />
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_DataHint}" />
                <TextBlock
                    Margin="0,4,0,8"
                    FontFamily="Consolas"
                    Text="{Binding DataFolder}"
                    TextWrapping="Wrap" />
                <WrapPanel>
                    <ui:Button
                        Margin="0,0,8,4"
                        Command="{Binding OpenDataFolderCommand}"
                        Content="{l:Loc Common_OpenFolder}"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button
                        Margin="0,0,8,4"
                        Command="{Binding ExportSettingsCommand}"
                        Content="{l:Loc Settings_Export}"
                        Icon="{ui:SymbolIcon ArrowExport24}" />
                    <ui:Button
                        Margin="0,0,8,4"
                        Command="{Binding ImportSettingsCommand}"
                        Content="{l:Loc Settings_Import}"
                        Icon="{ui:SymbolIcon ArrowImport24}" />
                    <ui:Button
                        Margin="0,0,8,4"
                        Appearance="Danger"
                        Command="{Binding ResetSettingsCommand}"
                        Content="{l:Loc Settings_Reset}"
                        Icon="{ui:SymbolIcon ArrowReset24}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
