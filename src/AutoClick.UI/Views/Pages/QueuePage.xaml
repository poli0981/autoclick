<Page
    x:Class="AutoClick.UI.Views.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutoClick.UI.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:AutoClick.UI.Localization"
    xmlns:logging="clr-namespace:AutoClick.Services.Logging;assembly=AutoClick.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:AutoClick.UI.Views"
    xmlns:vm="clr-namespace:AutoClick.UI.ViewModels"
    d:DataContext="{d:DesignInstance vm:QueueViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <StackPanel Margin="0,8,0,24">
        <!--  Title and actions  -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Title" Text="{l:Loc Nav_Queue}" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GamesCountText}" />
            </StackPanel>
            <WrapPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <ui:Button
                    Margin="4"
                    Appearance="Primary"
                    Command="{Binding AddGameCommand}"
                    Content="{l:Loc Queue_AddGame}"
                    Icon="{ui:SymbolIcon Add24}" />
                <ui:Button
                    Margin="4"
                    Command="{Binding StartAllCommand}"
                    Content="{l:Loc Queue_StartAll}"
                    Icon="{ui:SymbolIcon Play24}" />
                <ui:Button
                    Margin="4"
                    Command="{Binding StopAllCommand}"
                    Content="{l:Loc Queue_StopAll}"
                    Icon="{ui:SymbolIcon Stop24}" />
                <ui:Button
                    Margin="4"
                    AutomationProperties.Name="{l:Loc Session_Import}"
                    Command="{Binding ImportSessionCommand}"
                    Icon="{ui:SymbolIcon ArrowImport24}"
                    ToolTip="{l:Loc Session_Import}" />
                <ui:Button
                    Margin="4"
                    AutomationProperties.Name="{l:Loc Session_Export}"
                    Command="{Binding ExportSessionCommand}"
                    Icon="{ui:SymbolIcon ArrowExport24}"
                    ToolTip="{l:Loc Session_Export}" />
                <ui:Button
                    Margin="4"
                    Appearance="Transparent"
                    AutomationProperties.Name="{l:Loc Queue_RemoveAll}"
                    Command="{Binding RemoveAllCommand}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{l:Loc Queue_RemoveAll}" />
            </WrapPanel>
        </Grid>

        <!--  Scheduler  -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Symbol="CalendarClock24" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="{l:Loc Schedule_Title}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="{Binding ScheduleStatus}" />
                </StackPanel>
                <WrapPanel>
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="{l:Loc Schedule_Start}" />
                    <ui:TextBox
                        Width="110"
                        Margin="0,0,16,4"
                        IsEnabled="{Binding IsScheduleArmed, Converter={x:Static views:InvertBoolConverter.Instance}}"
                        PlaceholderText="HH:mm"
                        AutomationProperties.Name="{l:Loc Schedule_Start}"
                        Text="{Binding ScheduleStart, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="{l:Loc Schedule_Stop}" />
                    <ui:TextBox
                        Width="110"
                        Margin="0,0,16,4"
                        IsEnabled="{Binding IsScheduleArmed, Converter={x:Static views:InvertBoolConverter.Instance}}"
                        PlaceholderText="{l:Loc Schedule_StopOptional}"
                        AutomationProperties.Name="{l:Loc Schedule_Stop}"
                        Text="{Binding ScheduleStop, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="0,0,8,4"
                        Command="{Binding ArmScheduleCommand}"
                        Content="{l:Loc Schedule_Arm}"
                        Icon="{ui:SymbolIcon Timer24}"
                        Visibility="{Binding IsScheduleArmed, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button
                        Margin="0,0,8,4"
                        Command="{Binding CancelScheduleCommand}"
                        Content="{l:Loc Schedule_Cancel}"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Visibility="{Binding IsScheduleArmed, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="{Binding ScheduleMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ScheduleMessage, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>
        </Border>

        <!--  Empty state  -->
        <Border
            Padding="24,32"
            Style="{StaticResource SectionCard}"
            Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="Games24" />
                <ui:TextBlock
                    Margin="0,12,0,4"
                    HorizontalAlignment="Center"
                    FontTypography="BodyStrong"
                    Text="{l:Loc Queue_EmptyTitle}" />
                <TextBlock
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{l:Loc Queue_EmptyMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Games  -->
        <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GameSessionViewModel}">
                    <controls:GameCard />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Live log  -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding ShowLogs, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="{l:Loc Log_Title}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button
                            Margin="4,0"
                            Appearance="Transparent"
                            Command="{Binding ClearLogCommand}"
                            Content="{l:Loc Log_Clear}" />
                        <ui:Button
                            Margin="4,0"
                            Appearance="Transparent"
                            Command="{Binding ExportLogCommand}"
                            Content="{l:Loc Log_Export}"
                            Icon="{ui:SymbolIcon ArrowExport24}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Appearance="Transparent"
                            Command="{Binding OpenLogsFolderCommand}"
                            Content="{l:Loc Log_OpenFolder}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </StackPanel>
                </Grid>
                <ListBox
                    Height="220"
                    views:AutoScroll.IsEnabled="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    ItemsSource="{Binding LogLines}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListBoxItemStyle}" TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type logging:LogLine}">
                            <TextBlock
                                x:Name="Line"
                                Text="{Binding Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Debug">
                                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
