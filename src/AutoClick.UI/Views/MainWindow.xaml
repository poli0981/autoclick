<ui:FluentWindow
    x:Class="AutoClick.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:AutoClick.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:AutoClick.UI.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutoClick.UI.ViewModels"
    Title="{Binding Title}"
    Width="1180"
    Height="820"
    MinWidth="880"
    MinHeight="600"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The title bar has its own row: overlaid (as in the WPF-UI gallery) it covers the
              first item of a LeftFluent pane.  -->
        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="24,0,24,0"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            PaneDisplayMode="LeftFluent"
            Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_Queue}"
                    Icon="{ui:SymbolIcon Games24}"
                    TargetPageType="{x:Type pages:QueuePage}" />
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_Dashboard}"
                    Icon="{ui:SymbolIcon DataHistogram24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_Settings}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_About}"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>

            <!--  App-wide notices, shown above every page.  -->
            <ui:NavigationView.Header>
                <StackPanel Margin="24,8,24,0">
                    <ui:InfoBar
                        Title="{l:Loc Notice_AdminTitle}"
                        Margin="0,0,0,8"
                        IsClosable="True"
                        IsOpen="{Binding ShowAdminNotice, Mode=TwoWay}"
                        Message="{l:Loc Notice_AdminMessage}"
                        Severity="Informational">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding TurnOffAdminModeCommand}" Content="{l:Loc Notice_AdminTurnOff}" />
                        </StackPanel>
                    </ui:InfoBar>
                    <ui:InfoBar
                        Title="{l:Loc Notice_ElevationTitle}"
                        Margin="0,0,0,8"
                        IsClosable="True"
                        IsOpen="{Binding ShowElevationRequired, Mode=TwoWay}"
                        Message="{Binding ElevationRequiredMessage}"
                        Severity="Warning">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding RestartAsAdministratorCommand}"
                            Content="{l:Loc Admin_Restart}"
                            Icon="{ui:SymbolIcon ShieldKeyhole24}" />
                    </ui:InfoBar>
                    <ui:InfoBar
                        Title="{l:Loc Notice_ElevationDeclinedTitle}"
                        Margin="0,0,0,8"
                        IsClosable="True"
                        IsOpen="{Binding ShowElevationDeclined, Mode=TwoWay}"
                        Message="{l:Loc Notice_ElevationDeclined}"
                        Severity="Warning" />
                    <ui:InfoBar
                        Title="{l:Loc Notice_SettingsRecoveredTitle}"
                        Margin="0,0,0,8"
                        IsClosable="True"
                        IsOpen="{Binding ShowSettingsRecovered, Mode=TwoWay}"
                        Message="{Binding SettingsRecoveredMessage}"
                        Severity="Error">
                        <ui:Button Command="{Binding OpenSettingsBackupCommand}" Content="{l:Loc Common_OpenFolder}" />
                    </ui:InfoBar>
                    <ui:InfoBar
                        Title="{l:Loc Notice_UpdateTitle}"
                        Margin="0,0,0,8"
                        IsClosable="True"
                        IsOpen="{Binding ShowUpdateReady, Mode=TwoWay}"
                        Message="{Binding UpdateReadyMessage}"
                        Severity="Success">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ApplyUpdateCommand}"
                            Content="{l:Loc Update_ApplyRestart}"
                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                    </ui:InfoBar>
                </StackPanel>
            </ui:NavigationView.Header>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!--  Status bar  -->
        <Border
            Grid.Row="2"
            Padding="16,6"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding Queue.StatusText}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{l:Loc Stats_TotalClicks}" /><Run Text=": " /><Run Text="{Binding Queue.TotalClicks, Mode=OneWay}" />
                </TextBlock>
                <Border
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    Padding="8,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="4"
                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="12" Text="{l:Loc Status_Administrator}" />
                </Border>
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding VersionText}" />
            </Grid>
        </Border>

        <ui:ContentDialogHost
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
