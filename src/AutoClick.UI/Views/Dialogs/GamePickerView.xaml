<UserControl
    x:Class="AutoClick.UI.Views.Dialogs.GamePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abs="clr-namespace:AutoClick.Core.Abstractions;assembly=AutoClick.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:AutoClick.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutoClick.UI.ViewModels"
    Width="640"
    d:DataContext="{d:DesignInstance vm:GamePickerViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                x:Name="SearchBox"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{l:Loc Picker_Search}"
                Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Stretch"
                Command="{Binding RefreshCommand}"
                Content="{l:Loc Common_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>

        <ui:TextBlock
            Grid.Row="1"
            Margin="0,0,0,8"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{l:Loc Picker_Hint}"
            TextWrapping="Wrap" />

        <Grid Grid.Row="2" Height="360">
            <ListView
                x:Name="WindowList"
                ItemsSource="{Binding Windows}"
                MouseDoubleClick="OnListDoubleClick"
                SelectedItem="{Binding Selected, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type abs:WindowInfo}">
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,0,12,0"
                                FontSize="20"
                                Symbol="Window24" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="{Binding ProcessName}" />
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding ExecutablePath}" />
                            </StackPanel>
                            <Border
                                x:Name="AdminBadge"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4"
                                ToolTip="{l:Loc Picker_AdminTooltip}"
                                Visibility="Collapsed">
                                <TextBlock FontSize="12" Text="{l:Loc Picker_AdminBadge}" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Elevation}" Value="Higher">
                                <Setter TargetName="AdminBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ui:TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:Loc Picker_Empty}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
