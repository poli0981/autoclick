<Application
    x:Class="AutoClick.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:AutoClick.UI.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:AutoClick.UI.Views"
    xmlns:vm="clr-namespace:AutoClick.UI.ViewModels"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <views:LocKeyConverter x:Key="LocKey" />
            <views:StepTextConverter x:Key="StepText" />
            <views:ColorRefToBrushConverter x:Key="ColorRefToBrush" />
            <views:ColorRefToHexConverter x:Key="ColorRefToHex" />

            <!--  Combo box items are Choice records: show the localized label of their key.  -->
            <DataTemplate x:Key="OptionTemplate" DataType="{x:Type vm:Choice}">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocKey}">
                            <Binding Path="LabelKey" />
                            <Binding Path="Culture" Source="{x:Static l:LocalizationService.Instance}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>

            <!--  A titled section card used by every page.  -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
