<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- PackageVersion entries below also pin transitive dependencies. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="LiveChartsCore" Version="2.0.5" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView" Version="2.0.5" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Transitive pins: LiveCharts2 does not support SkiaSharp 4 yet (Live-Charts/LiveCharts2#2366);
       3.119.4 carries the bundled libpng/libexpat security fixes. -->
  <ItemGroup Label="Transitive pins">
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.Views.Desktop.Common" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
